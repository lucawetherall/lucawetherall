---
import PageLayout from '../layouts/PageLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<PageLayout
  title="Contact - Luca Wetherall"
  description="Luca Wetherall is a bass, jazz pianist, guitarist, composer, and musicologist based in London."
>
  <article>
    <h1 class="page-title">Contact</h1>
    <div class="content">
      <ContactForm />
    </div>
  </article>
</PageLayout>

<style>
  .page-title {
    margin-bottom: var(--space-50);
  }
</style>
