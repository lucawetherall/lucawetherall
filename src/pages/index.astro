---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import headshot from '../assets/headshot.png';

const siteUrl = 'https://lucawetherall.co.uk';
const personId = `${siteUrl}/#person`;
const websiteId = `${siteUrl}/#website`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${siteUrl}/`,
      url: `${siteUrl}/`,
      name: 'Luca Wetherall - Conductor, Bass, Pianist, Musicologist, Arranger',
      isPartOf: { '@id': websiteId },
      about: { '@id': personId },
      description: 'Luca is a bass, conductor, pianist, guitarist, and arranger based in London. He is a DPhil researcher and Tutor at the University of Oxford.',
      inLanguage: 'en-GB',
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: `${siteUrl}/`,
      name: 'Luca Wetherall',
      description: 'Conductor · Bass · Pianist · Singing Teacher',
      publisher: { '@id': personId },
      inLanguage: 'en-GB',
    },
    {
      '@type': ['Person', 'Organization'],
      '@id': personId,
      name: 'Luca Wetherall',
      jobTitle: 'Conductor, bass, pianist, singing teacher, and arranger',
      url: `${siteUrl}/`,
      image: `${siteUrl}/og-image.png`,
      affiliation: {
        '@type': 'Organization',
        name: 'University of Oxford',
      },
      sameAs: [
        'https://www.instagram.com/lu.ca.w/',
        'https://www.youtube.com/c/LucaWetherall',
        'https://www.tiktok.com/@luca.wetherall',
      ],
    },
  ],
};
---

<BaseLayout jsonLd={jsonLd}>
  <Header showOnMobileOnly />
  <main id="main">
    <section class="hero alignwide">
      <div class="hero__image-col">
        <div class="hero__top-spacer" aria-hidden="true"></div>
        <Image
          src={headshot}
          alt="Luca Wetherall"
          widths={[411, 600]}
          sizes="(min-width: 782px) 411px, 80vw"
          loading="eager"
          fetchpriority="high"
          class="hero__headshot"
        />
      </div>
      <div class="hero__text-col">
        <h1 class="hero__name">Luca Wetherall</h1>
        <p class="hero__line"><strong>Conductor, bass, pianist, singing teacher, and arranger.</strong></p>
        <p class="hero__line">Musicologist and Tutor at the <strong>University of Oxford.</strong></p>
        <p class="hero__line"><em>Get in touch <a href="/contact"><strong>here</strong></a><strong>.</strong></em></p>
        <div class="hero__bottom-spacer" aria-hidden="true"></div>
      </div>
    </section>

    <section class="row alignwide spectral-override">
      <div class="row__col">
        <p class="row__label"><strong>About:</strong></p>
        <p class="row__body">
          Luca is a highly experienced musician working across multiple disciplines and genres. He is the Director of Music and Organist at <a href="https://www.stmaryacton.org.uk/" target="_blank" rel="noreferrer noopener">St. Mary’s Acton</a>, Director of the <a href="http://www.almaconsort.com" target="_blank" rel="noreferrer noopener">Alma Consort</a> and one of the Choral Directors at <a href="https://hollandparkbenefice.org/about-st-john-the-baptist" target="_blank" rel="noreferrer noopener">St. John the Baptist Holland Road</a>. He is an accomplished singer working as a low bass in opera and in choral music. As a pianist, he is highly renowned for his abilities as an improviser and sight-reader.
        </p>
        <p class="row__body">
          He is also an academic musicologist and currently holds a Clarendon Scholarship at the University of Oxford where he is undertaking his doctoral research in popular music and working as a Tutor for the Faculty of Music.
        </p>
        <p class="row__body"><em>Read more <strong><a href="/about">here</a></strong></em>. <em>Enquire about teaching <strong><a href="/teaching">here</a></strong></em>.</p>
      </div>

      <div class="row__col">
        <p class="row__label"><strong>Recent Projects:</strong></p>
        <ul class="row__list">
          <li>Musical Director and Music Supervisor: <em>Disunited Jukebox</em> (Company Carpi / Arts Council England UK Tour)</li>
          <li>Assistant Musical Director: Hildegard’s <em>Ordo Virtutum</em> (Kensington Olympia Festival of Music)</li>
          <li>Musical Director (Barnes Community Choir / Barnes Concert Band 2025)</li>
          <li>Bass: <em>Fête Galante</em> (Ethel Smyth / Pegasus Opera)</li>
          <li>Accompanist (Barnes Music Festival 2025)</li>
          <li>Assistant Musical Director / Orchestrator: <em>The Power of Camelot</em> (Ruth Chan / British Youth Music Theatre)</li>
          <li>Producer: <em>The Blue Bird</em> (BBC Radio 3)</li>
          <li>Session Singer: <em>SAULT</em> (Air I, Air II, Drumsheds Live)</li>
        </ul>
      </div>
    </section>

    <div class="hero__row-spacer" aria-hidden="true"></div>
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    padding-inline: var(--page-padding-x);
    padding-top: var(--space-40);
  }

  /* Hero row */
  .hero {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--block-gap);
    margin-top: 0;
  }

  .hero__image-col {
    flex: 0 0 calc(50% - var(--block-gap) / 2);
    min-width: 0;
    align-self: center;
    padding-inline: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__text-col {
    flex: 0 0 calc(40% - var(--block-gap) / 2);
    min-width: 0;
    align-self: flex-end;
    padding-inline: var(--space-50);
    display: flex;
    flex-direction: column;
  }

  .hero__top-spacer { height: 100px; }
  .hero__bottom-spacer { height: 63px; }

  .hero__headshot {
    width: 411px;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    max-width: 100%;
  }

  .hero__name {
    font-family: var(--font-sans);
    font-size: clamp(40.809px, 2.551rem + ((1vw - 3.2px) * 6.24), 77px);
    line-height: 0.8;
    font-weight: 700;
  }

  .hero__line {
    font-family: var(--font-sans);
    font-size: var(--fs-medium);
  }
  .hero__line + .hero__line { margin-top: var(--space-30); }
  .hero__name + .hero__line { margin-top: var(--space-30); }

  /* About / Recent Projects row */
  .row {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--block-gap);
    margin-top: var(--space-40);
    align-items: flex-start;
  }

  .row__col {
    flex: 1 1 0;
    min-width: 0;
    padding-inline: var(--space-50);
  }

  .row__label {
    font-size: clamp(0.929rem, 0.929rem + ((1vw - 0.2rem) * 1.299), 1.4rem);
    font-family: var(--font-serif);
  }

  .row__body {
    font-size: clamp(0.875rem, 0.875rem + ((1vw - 0.2rem) * 0.621), 1.1rem);
  }

  .row__list {
    padding-left: var(--block-gap);
  }
  .row__list li {
    font-size: clamp(0.875rem, 0.875rem + ((1vw - 0.2rem) * 0.759), 1.15rem);
    line-height: 1.3;
  }
  .row__list li + li { margin-top: var(--space-20); }

  .row__label + .row__body,
  .row__label + .row__list { margin-top: var(--space-30); }

  .hero__row-spacer { height: 2rem; }

  /* Mobile / small-tablet stack */
  @media (max-width: 781px) {
    .hero,
    .row {
      flex-direction: column;
      flex-wrap: wrap;
      gap: 0;
    }
    .hero__image-col,
    .hero__text-col,
    .row__col {
      flex: 1 1 100%;
    }
    /* Headshot above the H1, slightly, with its left edge aligned with the
       page content (matches the "About:" heading position). */
    .hero__image-col {
      align-items: flex-start;
      align-self: stretch;
      width: 100%;
    }
    /* No spacers on mobile — use margins for consistent rhythm */
    .hero__top-spacer,
    .hero__bottom-spacer { display: none; }
    .hero__text-col {
      align-self: stretch;
      padding-inline: 0;
      text-align: left;
    }
    .row__col {
      padding-inline: 0;
    }
    /* Constrain hero H1 so "Luca Wetherall" fits on one line at small widths */
    .hero__name {
      font-size: clamp(2.4rem, 9vw, 3.2rem);
      line-height: 1;
      margin-top: var(--space-20);
    }
    .hero__line {
      font-size: var(--fs-small);
    }
    /* Headshot — left-aligned, smaller, hugs the page edge.
       Drop aspect-ratio so the natural 651×772 ratio renders without transparent
       letterboxing, which made the image visually offset from the left edge. */
    .hero__headshot {
      width: 170px;
      aspect-ratio: auto;
      object-fit: cover;
      margin-left: 0;
      margin-right: auto;
    }
    /* Consistent paragraph rhythm on mobile */
    .hero__line + .hero__line { margin-top: var(--space-30); }
    .hero__name + .hero__line { margin-top: var(--space-30); }
    /* Tighten body text for narrow screens */
    .row__body,
    .row__list li {
      font-size: var(--fs-small);
    }
    .row__label {
      font-size: var(--fs-medium);
    }
    /* Stack About / Recent Projects with consistent breathing room */
    .row {
      gap: var(--space-50);
      margin-top: var(--space-50);
    }
    /* Tighter recent-projects list on mobile */
    .row__list li + li { margin-top: var(--space-30); }
    .row__label + .row__body,
    .row__label + .row__list { margin-top: var(--space-30); }
    .row__body + .row__body { margin-top: var(--space-30); }
  }
</style>
