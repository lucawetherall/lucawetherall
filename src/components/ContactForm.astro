---
// Web3Forms contact form.
// The access key (free, public — safe to expose client-side — from
// https://web3forms.com) is read from the PUBLIC_WEB3FORMS_KEY build-time env
// var. Set it in the deploy workflow / a local .env to activate the form.
// TODO before launch: until the key is set, the form appears functional but
// submissions fail with "Something went wrong".
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? 'YOUR_ACCESS_KEY_HERE';
---

<form class="cform" action="https://api.web3forms.com/submit" method="POST" id="contact-form">
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="New message from lucawetherall.co.uk" />
  <input type="hidden" name="from_name" value="lucawetherall.co.uk" />
  <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />

  <p class="cform__field">
    <label for="your-name">Your Name (required)</label>
    <input
      type="text"
      id="your-name"
      name="your-name"
      maxlength="400"
      required
      autocomplete="name"
    />
  </p>

  <p class="cform__field">
    <label for="your-email">Your Email (required)</label>
    <input
      type="email"
      id="your-email"
      name="your-email"
      maxlength="400"
      required
      autocomplete="email"
    />
  </p>

  <p class="cform__field">
    <label for="your-subject">Subject</label>
    <input
      type="text"
      id="your-subject"
      name="your-subject"
      maxlength="400"
    />
  </p>

  <p class="cform__field">
    <label for="your-message">Your Message</label>
    <textarea
      id="your-message"
      name="your-message"
      rows="10"
      maxlength="2000"
    ></textarea>
  </p>

  <p>
    <button type="submit" class="button" id="cform-submit">Send</button>
  </p>

  <p id="cform-result" class="cform__result" aria-live="polite"></p>
</form>

<style>
  .cform {
    max-width: 374px;
  }

  .cform__field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .cform__field + .cform__field,
  .cform__field + p,
  p + .cform__field {
    margin-top: var(--space-40);
  }

  .cform__field label {
    font-family: var(--font-serif);
    font-size: var(--fs-small);
  }

  .cform__field input,
  .cform__field textarea {
    font-family: inherit;
    font-size: var(--fs-small);
    color: var(--color-text);
    background-color: var(--color-bg);
    border: 1px solid var(--color-muted);
    border-radius: 2px;
    padding: 0.5rem;
    width: 100%;
    min-height: 36px;
  }
  .cform__field input:focus,
  .cform__field textarea:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-color: var(--color-accent);
  }
  .cform__field textarea {
    resize: vertical;
    min-height: 0;
    height: 9em;
    line-height: 1.3;
  }

  .cform__result {
    min-height: 1.5em;
    font-size: var(--fs-small);
  }
  .cform__result--success { color: #4c7b72; }
  .cform__result--error { color: #a14444; }
</style>

<script>
  // Bind on every page load (initial + after each view transition). A top-level
  // script runs only once, so without this the AJAX handler would be missing
  // when the contact page is reached via client-side navigation, silently
  // falling back to a native POST. The dataset guard avoids double-binding.
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const result = document.getElementById('cform-result');
    const submitBtn = document.getElementById('cform-submit') as HTMLButtonElement | null;
    if (!form || !result || !submitBtn || form.dataset.bound) return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
      result.textContent = '';
      result.className = 'cform__result';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
        });
        const data = await response.json();

        if (data.success) {
          result.textContent = 'Thank you — your message has been sent.';
          result.classList.add('cform__result--success');
          form.reset();
        } else {
          result.textContent = 'Something went wrong. Please try again or email directly.';
          result.classList.add('cform__result--error');
        }
      } catch {
        result.textContent = 'Something went wrong. Please try again or email directly.';
        result.classList.add('cform__result--error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send';
      }
    });
  }

  document.addEventListener('astro:page-load', setupContactForm);
</script>
