---
const currentYear = new Date().getFullYear();

const socialLinks = [
  { href: 'https://www.instagram.com/lu.ca.w/', label: 'Instagram', external: true },
  { href: 'https://www.youtube.com/c/LucaWetherall', label: 'YouTube', external: true },
  { href: 'https://www.tiktok.com/@luca.wetherall', label: 'TikTok', external: true },
  { href: '/contact', label: 'Contact', external: false },
];
---

<footer class="footer">
  <div class="footer__row alignwide">
    <div class="footer__left">
      <p class="footer__name"><a href="/">Luca Wetherall</a></p>
      <p class="footer__social">
        {socialLinks.map(({ href, label, external }, i) => (
          <>
            <a
              href={href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noreferrer noopener' : undefined}
            >{label}</a>
            {i < socialLinks.length - 1 && <span> / </span>}
          </>
        ))}
      </p>
    </div>
    <p class="footer__copy">Luca Wetherall © {currentYear}</p>
  </div>
</footer>

<style>
  .footer {
    padding-top: var(--space-80);
    padding-inline: var(--space-50);
    padding-bottom: 0;
  }

  .footer__row {
    display: flex;
    flex-wrap: nowrap;
    justify-content: space-between;
    align-items: center;
    padding-block: var(--space-60);
  }

  .footer__left {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: var(--space-30);
  }

  .footer__name {
    font-family: var(--font-sans);
    font-size: var(--fs-medium);
    font-weight: 700;
    line-height: 1.125;
  }
  .footer__name a {
    text-decoration: none;
    color: var(--color-text);
  }
  .footer__name a:hover {
    text-decoration: underline;
  }

  .footer__social {
    font-family: var(--font-sans);
    font-size: var(--fs-x-small);
  }
  .footer__social a {
    color: var(--color-text);
  }

  .footer__copy {
    font-family: var(--font-serif);
    font-size: var(--fs-x-small);
    text-align: right;
  }

  @media (max-width: 781px) {
    .footer__row {
      flex-wrap: wrap;
      gap: var(--space-30);
    }
    .footer__left {
      flex-wrap: wrap;
    }
    .footer__copy {
      text-align: left;
      width: 100%;
    }
  }
</style>
