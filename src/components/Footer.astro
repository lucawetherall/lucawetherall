---
const currentYear = new Date().getFullYear();

const socialLinks = [
  { href: 'https://instagram.com/lu.ca.w', label: 'Instagram' },
  { href: 'https://youtube.com/@lucawetherall', label: 'YouTube' },
  { href: 'https://www.tiktok.com/@luca.wetherall', label: 'TikTok' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="footer">
  <div class="footer__inner container--wide">
    <div class="footer__left">
      <span class="footer__name">Luca Wetherall</span>
      <nav class="footer__links" aria-label="Social links">
        {socialLinks.map(({ href, label }, i) => (
          <>
            <a
              href={href}
              class="footer__link"
              target={href.startsWith('http') ? '_blank' : undefined}
              rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {label}
            </a>
            {i < socialLinks.length - 1 && (
              <span class="footer__separator">/</span>
            )}
          </>
        ))}
      </nav>
    </div>
    <div class="footer__right">
      <span>Luca Wetherall &copy; {currentYear}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: clamp(2rem, 5vw, 3rem) 0;
    border-top: 1px solid var(--color-border);
    margin-top: clamp(3rem, 8vw, 6rem);
  }

  .footer__inner {
    max-width: var(--container-wide);
    margin: 0 auto;
    padding-left: var(--container-padding);
    padding-right: var(--container-padding);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer__left {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .footer__name {
    font-weight: 500;
    font-size: clamp(0.95rem, 1vw + 0.3rem, 1.1rem);
  }

  .footer__links {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .footer__link {
    font-size: clamp(0.9rem, 0.9vw + 0.3rem, 1rem);
    color: var(--color-text-light);
  }

  .footer__link:hover {
    color: var(--color-text);
  }

  .footer__separator {
    color: var(--color-text-light);
    font-size: 0.9rem;
  }

  .footer__right {
    font-size: clamp(0.85rem, 0.9vw + 0.3rem, 0.95rem);
    color: var(--color-text-light);
  }

  @media (max-width: 640px) {
    .footer__inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.75rem;
    }

    .footer__left {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
